# Google AI Studio API key (get yours at https://aistudio.google.com/apikey)
# Genkit uses GEMINI_API_KEY or GOOGLE_API_KEY
GOOGLE_API_KEY=your-google-api-key

# Progress Observability Platform Integration key (prefix: ac_p_)
OBSERVABILITY_API_KEY=ac_p_your-integration-key

# App name shown in Progress dashboard
OBSERVABILITY_APP_NAME=family-travel-planner

# Gemini model to use (recommended for this tutorial: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite
